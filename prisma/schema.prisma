generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // For Neon/pgBouncer so migrations run on a direct (non-pooler) connection
  directUrl = env("DATABASE_DIRECT_URL")
}

/**
 * ========= NextAuth core models =========
 */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique

  accounts    Account[]
  sessions    Session[]
  playerStats PlayerStats?
  dailyStreak DailyStreak? // opposite side of DailyStreak.user relation
  dailyRuns   DailyRun[]   // optional runs linked to this user
  dailyPieces DailyPiece[] // collectible pieces

  // NEW: back-ref for Chain Mode runs
  chainRuns ChainRun[]

  // NEW: back-refs for RankedMatch relations
  rankedAsPlayerOne RankedMatch[] @relation("RankedPlayerOne")
  rankedAsPlayerTwo RankedMatch[] @relation("RankedPlayerTwo")

  // NEW (fix Prisma validation): opposite relation fields
  rankedRating RankedRating?
  ladderTicket LadderTicket?

  // ChainDex relations (ADDED earlier)
  dexUnlocks     DexUnlock[]
  dexDiscoveries DexDiscovery[]

  // WordCoins (ADDED now)
  wordcoinWallet  WordcoinWallet?
  wordcoinTxns    WordcoinTxn[]

  // ==== NEW: Cards / Deck / Purchases ====
  wordCards      WordCard[]
  deckSlots      DeckSlot[]
  packPurchases  PackPurchase[]
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token      String? @map("refresh_token")
  access_token       String? @map("access_token")
  expires_at         Int?    @map("expires_at")
  token_type         String? @map("token_type")
  scope              String?
  id_token           String? @map("id_token")
  session_state      String? @map("session_state")
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * ========= Game stats =========
 */

model PlayerStats {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalWords      Int @default(0)
  uniqueWords     Int @default(0)
  animals         Int @default(0)
  countries       Int @default(0)
  names           Int @default(0)
  sameLetterWords Int @default(0)
  switches        Int @default(0)
  linksEarned     Int @default(0)
  linksSpent      Int @default(0)

  bestScore            Int @default(0)
  longestChain         Int @default(0)
  highestMultiplier    Int @default(0)
  longestAnimalStreak  Int @default(0)
  longestCountryStreak Int @default(0)
  longestNameStreak    Int @default(0)

  badges Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Streaks (NEW) ---
  dailyStreak     Int       @default(0)
  puzzleStreak    Int       @default(0)
  lastPlayedAt    DateTime?
  lastCompletedAt DateTime?

  // Rolling log relation (NEW)
  streakEvents StreakEvent[]
}

/**
 * ========= Daily mode =========
 * - One submission per (userId, specId) or (deviceId, specId)
 * - Supports guests via deviceId
 */
model DailyRun {
  id           String   @id @default(cuid())
  userId       String? // NextAuth user id (optional if playing as guest)
  deviceId     String? // anonymous-device id (cookie) for guests
  specId       String  // e.g., "2025-09-15" or hash
  dateKey      String  // canonical daily key (e.g., "2025-09-15")
  score        Int
  wordsPlayed  String[] @default([])
  catsJson     Json     @default("{}") // { name: n, animal: n, ... }
  sameEnds     Int      @default(0)
  maxChain     Int      @default(0)
  completedAll Boolean  @default(false)
  createdAt    DateTime @default(now())

  /// authoritative elapsed seconds for speed LB
  timeTakenSec Float?   // NEW

  // Optional relation to User (SetNull on delete keeps guest/device runs intact)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Constraints: one entry per (user, spec) or (device, spec)
  @@unique([userId, specId], name: "uniq_user_spec")
  @@unique([deviceId, specId], name: "uniq_device_spec")

  // Fast lookups for leaderboards (score)
  @@index([specId, score(sort: Desc)], name: "idx_spec_score")
  @@index([dateKey, score(sort: Desc)], name: "idx_date_score")
  @@index([dateKey, createdAt], name: "idx_date_created")

  // Speed-based indexes (completed clears only)
  @@index([dateKey, completedAll, timeTakenSec(sort: Asc)], name: "idx_date_speed") // NEW
  @@index([specId, completedAll, timeTakenSec(sort: Asc)], name: "idx_spec_speed")  // NEW
}

model DailyStreak {
  userId    String   @id
  current   Int      @default(0)
  best      Int      @default(0)
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StreakEvent {
  id       String     @id @default(cuid())
  userId   String
  kind     StreakKind
  occurred DateTime   @default(now())

  player PlayerStats @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, occurred])
  @@map("StreakEvent")
}

enum StreakKind {
  PLAYED_ANY_MODE           // counts toward Daily Streak
  COMPLETED_DAILY_PUZZLE    // counts toward Puzzle Streak
}

/**
 * ========= Daily collectible piece =========
 * One row per (userId, dateKey) when a user beats that day's Daily.
 */
model DailyPiece {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String // e.g., "2025-09-16"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey], name: "userId_dateKey")
  @@index([userId, dateKey])
}

/**
 * ========= Chain Mode runs (leaderboard) =========
 * Stores score + longest chain; supports guests via deviceId and optional playerName.
 */
model ChainRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  userId     String?
  deviceId   String?
  playerName String?
  seasonKey  String   @default("global")
  score        Int
  longestChain Int
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, seasonKey], name: "uniq_chain_user_season")
  @@unique([deviceId, seasonKey], name: "uniq_chain_device_season")

  @@index([seasonKey, score(sort: Desc), createdAt], name: "idx_chain_season_score")
  @@index([seasonKey, longestChain(sort: Desc), createdAt], name: "idx_chain_season_longest")
  @@index([createdAt], name: "idx_chain_created")
  @@index([userId], name: "idx_chain_user")
  @@index([deviceId], name: "idx_chain_device")
}

/**
 * ========= Ladder / Elo support =========
 */
model RankedRating {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(1200)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([rating, updatedAt], name: "idx_rating_updatedAt")
}

model LadderTicket {
  id             String   @id @default(cuid())
  userId         String
  createdAt      DateTime @default(now())
  matchedMatchId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([createdAt])
}

enum RankedKind {
  DUEL
  LADDER
}

/**
 * ========= Ranked Chain battles =========
 * Stores results + optional Elo deltas for Ladder matches.
 */
model RankedMatch {
  id        String   @id @default(cuid())
  seed      String
  createdAt DateTime @default(now())

  kind RankedKind @default(DUEL)

  playerOneId String
  playerOne   User   @relation("RankedPlayerOne", fields: [playerOneId], references: [id])

  playerTwoId String?
  playerTwo   User?  @relation("RankedPlayerTwo", fields: [playerTwoId], references: [id])

  playerOneChainLength Int?
  playerOneScore       Int?
  playerTwoChainLength Int?
  playerTwoScore       Int?

  ratingDeltaOne Int?
  ratingDeltaTwo Int?

  winnerId    String?
  completedAt DateTime?

  @@index([createdAt])
  @@index([completedAt])
}

/**
 * ========= ChainDex progress (present) =========
 */
model DexUnlock {
  id        String   @id @default(cuid())
  userId    String
  category  String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key], name: "userId_category_key")
  @@index([userId, category])
}

model DexDiscovery {
  id        String   @id @default(cuid())
  userId    String
  category  String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key], name: "userId_category_key_discovery")
  @@index([userId, category])
}

/**
 * ========= WordCoins =========
 */
model WordcoinWallet {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WordcoinTxn {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], name: "idx_wc_user_created")
}

/**
 * ========= Cards / Deck / Purchases (NEW) =========
 */

enum CardRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum CardCategory {
  name
  animal
  country
  food
  brand
  screen
}

model WordCard {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      String
  category  CardCategory
  rarity    CardRarity
  createdAt DateTime     @default(now())

  deckSlots DeckSlot[]
  @@index([userId, createdAt])
}

model DeckSlot {
  id        String    @id @default(cuid())
  userId    String
  slotIndex Int
  cardId    String?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card WordCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([userId, slotIndex], name: "userId_slotIndex")
  @@index([userId])
}

model PackPurchase {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId       String
  coinsSpent   Int      @default(0)
  piecesSpent  Int      @default(0)
  cardsGranted Json
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
